      }
    ];

    let activeFilter = 'ALL';
    let sortByDistance = false;

    function calculateDistanceKm(lat1, lon1, lat2, lon2) {
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
        Math.sin(dLon / 2) * Math.sin(dLon / 2);
      return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
    }

    function setFilter(filterType) {
      activeFilter = filterType;
      const inactiveClass = "px-3 py-1.5 rounded-full text-xs font-medium transition bg-white/10 text-white hover:bg-white/20";
      const activeClass = "px-3 py-1.5 rounded-full text-xs font-semibold transition bg-[#FFE600] text-[#004B87] shadow-sm";

      document.getElementById('tab-all').className = filterType === 'ALL' ? activeClass : inactiveClass;
      document.getElementById('tab-online').className = filterType === 'Online' ? activeClass : inactiveClass;
      document.getElementById('tab-dbs').className = filterType === 'DBS' ? activeClass : inactiveClass;

      renderStations();
    }

    function clearSearch() {
      document.getElementById('searchInput').value = '';
      renderStations();
    }

    function resetAllFilters() {
      document.getElementById('searchInput').value = '';
      setFilter('ALL');
    }

    function findNearestByGPS() {
      const btn = document.getElementById('gpsBtn');
      const btnText = document.getElementById('gpsBtnText');
      const banner = document.getElementById('gpsStatusBanner');

      if (!navigator.geolocation) {
        banner.textContent = "Location not supported by browser.";
        banner.classList.remove('hidden');
        return;
      }

      btnText.textContent = "Locating...";
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          stationsData.forEach(st => {
            st.distanceKm = calculateDistanceKm(pos.coords.latitude, pos.coords.longitude, st.lat, st.lng);
          });
          sortByDistance = true;
          btn.className = "px-3 py-1.5 rounded-full text-xs font-semibold transition bg-[#FFE600] text-[#004B87] shadow-sm";
          btnText.textContent = "Nearest Active";
          banner.classList.add('hidden');
          renderStations();
        },
        () => {
          btnText.textContent = "Nearest First";
          banner.textContent = "Please allow location access to sort by nearest.";
          banner.classList.remove('hidden');
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    }

    function renderStations() {
      const query = document.getElementById('searchInput').value.trim().toLowerCase();
      const clearBtn = document.getElementById('clearSearchBtn');
      const listContainer = document.getElementById('stationsList');
      const emptyState = document.getElementById('emptyState');

      clearBtn.classList.toggle('hidden', query.length === 0);

      let filtered = stationsData.filter(st => {
        const matchesTab = activeFilter === 'ALL' || st.type === activeFilter;
        const matchesQuery = !query || st.displayTitle.toLowerCase().includes(query);
        return matchesTab && matchesQuery;
      });

      if (sortByDistance) {
        filtered.sort((a, b) => (a.distanceKm || 9999) - (b.distanceKm || 9999));
      }

      if (filtered.length === 0) {
        listContainer.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      listContainer.innerHTML = filtered.map(st => {
        const isOnline = st.type === 'Online';
        const blockClass = isOnline ? 'station-block-online' : 'station-block-dbs';
        const distancePill = st.distanceKm !== undefined
          ? `<span class="ml-2 px-2 py-0.5 rounded-full bg-black/25 text-[11px] font-medium text-white/95 no-underline">${st.distanceKm.toFixed(1)} km</span>`
          : '';

        return `
          <a
            href="${st.url}"
            target="_blank"
            rel="noopener noreferrer"
            class="${blockClass} relative block w-full rounded-[8px] py-[16px] px-[20px] mb-[14px] text-center group"
          >
            <span class="text-white font-medium text-[15px] sm:text-[16px] underline underline-offset-4 decoration-white/75 group-hover:decoration-white">
              ${st.displayTitle}
            </span>
            ${distancePill}
            <i class="fa-solid fa-arrow-up-right-from-square text-xs text-white/50 opacity-0 group-hover:opacity-100 transition-opacity absolute right-4 top-1/2 -translate-y-1/2"></i>
          </a>
        `;
      }).join('');
    }

    window.onload = renderStations;
  </script>
